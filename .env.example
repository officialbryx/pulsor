# Copy to .env and adjust values for local development.
# All variables are optional - FraudPulse works with zero configuration.

# Slack incoming webhook used to alert on high-risk transactions.
SLACK_WEBHOOK_URL=

# When set, /score, /score/batch, and /explain require a matching X-API-Key header.
API_KEY=

# Risk score (0-1) at or above which a transaction is flagged as anomalous.
HIGH_RISK_THRESHOLD=0.8

# Comma-separated list of allowed CORS origins. Defaults to "*" for local testing.
CORS_ORIGINS=*

# Path to the trained model artifact.
MODEL_PATH=models/fraud_model.joblib

# Python logging level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
